# Local development defaults
OBSERVABILITY_ENV=development
OBSERVABILITY_DATA=data/observations.jsonl
OBSERVABILITY_USAGE_DATA=data/usage.jsonl
OBSERVABILITY_STORAGE=jsonl
OBSERVABILITY_SQLITE_DATA=data/observability.sqlite

# direct works with JSONL or SQLite. durable requires SQLite and returns HTTP 202.
OBSERVABILITY_INGEST_MODE=direct
OBSERVABILITY_QUEUE_MAX_ATTEMPTS=5
OBSERVABILITY_QUEUE_POLL_MS=250
OBSERVABILITY_QUEUE_LEASE_MS=30000

# Production must provide a non-empty secret. Never commit the real value.
OBSERVABILITY_API_KEY=replace-with-a-random-secret
OBSERVABILITY_CORS_ORIGINS=https://console.example.com

# Optional multi-tenant API key mapping: tenant_uuid=secret,tenant_uuid=secret
# When set, requests must send both X-API-Key and X-Tenant-ID.
# OBSERVABILITY_API_KEYS=00000000-0000-4000-8000-000000000010=replace-with-tenant-secret

# Optional single-tenant deployment boundary.
# OBSERVABILITY_TENANT_ID=00000000-0000-4000-8000-000000000010

# Optional model provider credentials for the agent CLI.
# MODEL_API_KEY=replace-with-provider-secret

# Optional server-side OpenAI-compatible provider for /v1/model/complete.
# MODEL_PROVIDER_URL=https://api.example.com/v1/chat/completions
# MODEL_API_KEY=replace-with-provider-secret
